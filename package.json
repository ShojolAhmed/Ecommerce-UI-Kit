{
  "name": "ecom-ui-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable React e-commerce UI components with interchangeable design variants.",
  "type": "module",
  "main": "./dist-lib/ecom-ui-kit.js",
  "module": "./dist-lib/ecom-ui-kit.js",
  "exports": {
    ".": {
      "import": "./dist-lib/ecom-ui-kit.js",
      "default": "./dist-lib/ecom-ui-kit.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:lib": "vite build --config vite.lib.config.js",
    "prepack": "npm run build:lib",
    "test:api": "npm run build:lib && node scripts/check-api.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}

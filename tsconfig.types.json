{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "outDir": "dist-lib/types",
    "rootDir": "src/library"
  },
  "include": ["src/library/**/*.js", "src/library/**/*.jsx"]
}
